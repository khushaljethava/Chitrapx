{
  "name": "chitrapx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @chitrapx/web --filter @chitrapx/worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "pnpm --filter @chitrapx/db migrate",
    "db:seed": "pnpm --filter @chitrapx/db seed"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "supabase": "^2.119.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
