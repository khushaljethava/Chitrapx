# Supabase project (Dashboard > Connect and Settings > API).
# DATABASE_URL: the Session pooler URL (IPv4, port 5432). pg-boss needs LISTEN/NOTIFY, so not the transaction pooler (6543).
# The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shows the dev-only noop job button and enables /api/dev/*
ENABLE_DEV_TOOLS=1
# Shared by web (verifies) and worker (signs) for the export render page; 32+ characters
RENDER_SECRET=
# Where the worker reaches the web app
WEB_ORIGIN=http://localhost:3000
# Claude API key for the AI jobs (design, translate, copy variants)
ANTHROPIC_API_KEY=
# Razorpay (billing). Test keys from dashboard.razorpay.com > Settings > API keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: URL <origin>/api/billing/webhook, events payment.captured, order.paid, subscription.*
RAZORPAY_WEBHOOK_SECRET=
# INR by default; must match the currency of the Razorpay Plans below
RAZORPAY_CURRENCY=INR
# Plan ids from Dashboard > Subscriptions > Plans (the price lives on the plan)
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_STUDIO=
# Shown on the billing page next to each plan, e.g. "₹999/month"
PRICE_LABEL_PRO=
PRICE_LABEL_STUDIO=

# Object storage: AWS S3, Cloudflare R2 or MinIO. Local: `pnpm storage:up && pnpm storage:setup`
# Leave S3_ENDPOINT empty for AWS. R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=chitrapx
S3_SECRET_ACCESS_KEY=chitrapx-dev-secret
S3_BUCKET_UPLOADS=chitrapx-uploads
S3_BUCKET_EXPORTS=chitrapx-exports
# true for MinIO (path-style URLs)
S3_FORCE_PATH_STYLE=true

# SP16. Build id shown to open tabs by /api/version (e.g. the git SHA); unset = a timestamp per build
BUILD_ID=
# "on" turns on first-party, consent-gated usage counting (stored in our own analytics_events table)
NEXT_PUBLIC_ANALYTICS=
# Comma-separated emails that may moderate the community feed (/dashboard/community/review)
STAFF_EMAILS=
